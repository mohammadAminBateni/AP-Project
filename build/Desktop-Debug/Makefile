####### Compile

clienthandler.o: ../../clienthandler.cpp ../../clienthandler.h \
		../../server.h \
		../../user.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o clienthandler.o ../../clienthandler.cpp

gamesession.o: ../../gamesession.cpp ../../gamesession.h \
		../../server.h \
		../../user.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o gamesession.o ../../gamesession.cpp

main.o: ../../main.cpp ../../mainwindow.h \
		../../server.h \
		../../user.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

mainwindow.o: ../../mainwindow.cpp ../../mainwindow.h \
		../../server.h \
		../../user.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o ../../mainwindow.cpp

server.o: ../../server.cpp ../../server.h \
		../../user.h \
		../../clienthandler.h \
		../../gamesession.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o server.o ../../server.cpp

user.o: ../../user.cpp ../../user.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o user.o ../../user.cpp

moc_clienthandler.o: moc_clienthandler.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_clienthandler.o moc_clienthandler.cpp

moc_gamesession.o: moc_gamesession.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_gamesession.o moc_gamesession.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_server.o: moc_server.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_server.o moc_server.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Server1/bin || mkdir -p $(INSTALL_ROOT)/opt/Server1/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/Server1/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/Server1/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Server1/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

